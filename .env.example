# Base URL of the Laravel backend's API, including the version prefix.
# Local dev: point at `php artisan serve` (default http://localhost:8000).
# Production (Vercel): set this to the deployed backend's URL once it's hosted.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: a YouTube video ID shown as a labeled "Demo Preview" placeholder
# for any movie/episode without real video yet. Leave blank in production —
# unset it once the client's real video assets are wired up.
NEXT_PUBLIC_DEMO_VIDEO_YOUTUBE_ID=
